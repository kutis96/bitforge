  "settings": {
    "pvText": " \\uA5\\u9D\\u9D\\u9D\\u9D\\uA1\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u88\n \\u83 \\uF0\\uF1 \\u83 \\uFA\\uFB \\uFB \\uFC\\uFD\\uFE\\uFF.                  \\u83\n \\uA4\\u9D\\u9D\\u9D\\u9D\\u9F\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u9D\\u8E\n\n A simple editor of bitmap fonts.\n     _It even seems to work, sort of._\n\n Currently, it can also render cheap\n   _fake italic_ and *double-struck bold*\n   text, _*and even both at once!*_\n The possibilities are truly endless.\n            In other font editors.\n\n The quick brown fox\n jumps over a lazy dog.\n 0123456789",
    "pngBg": "solid",
    "pvScale": 3,
    "pvBold": false,
    "pvItalic": true,
    "pvBaseline": 5,
    "inverted": false,
    "qaShowSilenced": false,
    "pasteMode": "merge",
    "theme": "auto",
    "selCode": 98,
    "dogfood": false
  }
